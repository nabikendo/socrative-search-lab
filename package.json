{
  "name": "atlas-provas",
  "version": "1.2.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Atlas: provas em rede local, sem Internet durante a aula.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "npm run build && node --disable-warning=ExperimentalWarning server.mjs",
    "serve": "node --disable-warning=ExperimentalWarning server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "desktop:dev": "electron .",
    "desktop:package": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "pdfjs-dist": "5.4.149",
    "qrcode-generator": "^2.0.4",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "mammoth": "^1.9.1",
    "read-excel-file": "^9.3.14",
    "sanitize-html": "^2.17.0"
  },
  "main": "desktop/main.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/nabikendo/socrative-search-lab.git"
  },
  "build": {
    "appId": "br.com.atlas.provas",
    "productName": "Atlas",
    "directories": {
      "output": "release-desktop"
    },
    "files": [
      "desktop/**/*",
      "server.mjs",
      "lib/**/*",
      "shared/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "nabikendo",
      "repo": "socrative-search-lab",
      "channel": "beta",
      "releaseType": "prerelease"
    },
    "generateUpdatesFilesForAllChannels": true,
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Atlas-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
